# Tailscale enrollment. Set one of these.
TS_AUTHKEY=
TS_CLIENT_SECRET=

# Embedded gateway identity.
TS_HOSTNAME=chatgpt-ssh-gateway
TS_STATE_DIR=./data/tsnet
TS_ADVERTISE_TAGS=tag:chatgpt-ssh
TS_EPHEMERAL=false

# Independent local target allowlist. At least one tag or host is required.
TS_ALLOWED_TAGS=tag:chatgpt-managed
TS_ALLOWED_HOSTS=
TS_ALLOW_SHARED_NODES=false

# Dedicated remote account and exact service allowlist.
SSH_USER=chatgpt
SSH_ALLOWED_SERVICES=tailscaled.service
SSH_DIAL_TIMEOUT=10s
SSH_COMMAND_TIMEOUT=2m
SSH_MAX_OUTPUT_BYTES=262144
SSH_MAX_LOG_LINES=200
SSH_MAX_PROCESSES=100

# Operator mode is intentionally NOT persisted here. Enable one local session
# explicitly when launching, for example: OPERATOR_MODE=true make up
# The default Operator lease is one hour and still uses SSH_USER without adding sudo.

# Loopback is intended for OpenAI Secure MCP Tunnel or a local reverse proxy.
MCP_LISTEN_ADDR=127.0.0.1:8080
MCP_BEARER_TOKEN=
MCP_ALLOW_UNAUTHENTICATED=false
MCP_DISABLE_LOCALHOST_PROTECTION=false
MCP_MAX_REQUEST_BODY_BYTES=1048576

TS_UP_TIMEOUT=90s
SERVER_SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=info
